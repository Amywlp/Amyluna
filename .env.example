# ========================================
# amyluna v2 — 三进程 QQ 机器人
# ========================================

# --- 进程端口 ---
P1_PORT=3101
P2_PORT=3102
P3_PORT=3103

# --- MySQL (amyluna 库) ---
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_DATABASE=amyluna
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=30000

# --- SnowLuma WebSocket (P1) ---
SNOWLUMA_WS_URL=ws://127.0.0.1:3001
SNOWLUMA_ACCESS_TOKEN=your-access-token-here
SNOWLUMA_HEARTBEAT_INTERVAL_MS=30000
SNOWLUMA_RECONNECT_BASE_DELAY_MS=1000
SNOWLUMA_RECONNECT_MAX_DELAY_MS=30000

# --- LLM Relay (P3) ---
LLM_RELAY_DEFAULT_ALIAS=LLM
LLM_PROVIDERS_JSON=[{"id":"deepseek","aliases":["LLM"],"baseUrl":"https://api.deepseek.com/v1","apiKey":"your-api-key-here","model":"deepseek-v4-flash","enabled":true,"maxTokens":1024,"timeoutMs":30000},{"id":"sensenova","aliases":["vision"],"baseUrl":"https://token.sensenova.cn/v1","apiKey":"your-vision-api-key","model":"sensenova-6.7-flash-lite","enabled":true,"maxTokens":1024,"timeoutMs":60000}]

# --- Chat (P2) ---
PRESET_FILE=preset/holo.yaml
BOT_ID=0
TRIGGER_KEYWORDS=赫萝~
WHITELIST_GROUP_IDS=
ERROR_ALERT_GROUP_ID=0
CHAT_MAX_TURNS=6
CHAT_CONTEXT_LIMIT=30
CHAT_COOLDOWN_MS=10000
CHAT_REPLY_TIMEOUT_MS=60000
REPLY_MAX_LENGTH=500
ACCEPT_IMAGES=false
VISION_ALIAS=vision
IMAGE_PROMPT=你现在是一个图片描述大师。你需要根据下面提供的图片，对该图片或者图片列表生成 150-400 字的中文描述。包括图片的主要内容和场景，里面可能包含的梗，人物等。
PRD_C=0.0038

# --- MCP (P3) ---
MCP_SERVERS_JSON=[]

# --- Watchdog ---
WATCHDOG_INTERVAL_MS=5000
WATCHDOG_MAX_FAILURES=3

# --- TTS 语音合成 ---
# SoVITS API 地址
TTS_BASE_URL=http://127.0.0.1:9880
# 默认语音角色
TTS_VOICE=holo
# 语音配置目录（{voice}_infer_config.json）
TTS_VOICE_CONFIG_DIR=/home/USER/pythonprojects/audiobook_prepose
# 音频临时输出目录
TTS_OUTPUT_DIR=data/tts/
# 发送模式: sequential（默认，顺序发送）| forward-audio（保留，QQ bug）| forward-video（占位）
TTS_SEND_MODE=sequential
# API 超时（ms）
TTS_API_TIMEOUT_MS=120000
# 网络/5xx 最大重试次数
TTS_MAX_RETRIES=1
# 最大合成文本长度
TTS_MAX_TEXT_LEN=300
# 默认语言（lang 参数为空/无效时回退）
TTS_DEFAULT_LANG=zh
# 音频文件保留时间（ms），超时自动清理
TTS_FILE_TTL_MS=86400000

# --- Text2Image 文生图 ---
# API 基础地址
T2I_BASE_URL=https://token.sensenova.cn/v1
# API Key（留空则禁用文生图功能）
T2I_API_KEY=
# 提示词生成模型
T2I_PROMPT_MODEL=deepseek-v4-flash
# 图片生成模型
T2I_IMAGE_MODEL=sensenova-u1-fast
# 图片尺寸
T2I_IMAGE_SIZE=2752x1536
# 图片暂存目录
T2I_OUTPUT_DIR=/home/USER/temp_files/text2image/
# 提示词生成超时（ms）
T2I_PROMPT_TIMEOUT_MS=60000
# 图片生成超时（ms）
T2I_IMAGE_TIMEOUT_MS=120000
# 最大重试次数
T2I_MAX_RETRIES=1
# 最大主题描述长度
T2I_MAX_TOPIC_LEN=200
# 图片暂存保留时间（ms）
T2I_FILE_TTL_MS=86400000
# 提示词生成系统预设文件路径
T2I_PRESET_PATH=preset/text2image.yaml

# --- Silent Tool Task Queue ---
# 需要通过任务队列管理的静默工具（逗号分隔）
# 支持: timer, affinity, tts, muri_agent, text2image
# 留空则不启用任务队列
SILENT_TOOL_QUEUE=text2image
# 不可并行的静默工具（逗号分隔），标记的工具将串行执行（FIFO）
TASK_QUEUE_SERIAL=tts,muri_agent,text2image
